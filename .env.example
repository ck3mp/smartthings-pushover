# ---- Washer -------------------------------------------------------------
WASHER_IP=192.168.1.40
# Leave blank to auto-discover across 5684 + 49152-49160 (the WW80 uses 49154)
WASHER_PORT=
WASHER_NAME=Washing machine

# ---- Pushover -----------------------------------------------------------
PUSHOVER_TOKEN=your-application-token
PUSHOVER_USER=your-user-key
# Optional: restrict to one device name, pick a sound, set priority (-2..1)
PUSHOVER_DEVICE=
PUSHOVER_SOUND=
PUSHOVER_PRIORITY=0
# Sound used only for the "laundry is done" message (e.g. magic, bike)
PUSHOVER_FINISHED_SOUND=
# Priority for alarm/error notifications
PUSHOVER_ALARM_PRIORITY=1

# ---- Events --------------------------------------------------------------
# Comma-separated. Default: cycle_started,cycle_finished,cycle_paused,cycle_cancelled,alarm
# All: cycle_started,cycle_finished,cycle_paused,cycle_resumed,cycle_cancelled,
#      phase_changed,alarm,power_on,power_off,remote_control,child_lock,offline,online
# Or EVENTS=all
EVENTS=

# Map course codes to names for nicer messages. Find the code with --dump.
# COURSE_NAMES=1C=Eco 40-60,1B=Cotton
# WW80CGC04DAEEU (Table_02), derived from the firmware option table + manual:
# COURSE_NAMES=1C=Eco 40-60,1B=Cotton,25=Synthetics,20=Hygiene Steam,08=Rinse+Spin,74=Drum Clean,87=Downloaded,06=Bedding,7F=Wool/Delicates,65=Colours,8F=Intense Cold,96=Less Microfiber,34=Mixed Load,A0=Quick Wash 15'
COURSE_NAMES=

# Send a message when the bridge connects for the first time
STARTUP_NOTIFY=false
# Minutes -> seconds before an "offline" event fires (only if enabled)
OFFLINE_AFTER_S=900

# ---- Tuning (defaults are fine) -------------------------------------------
# Cert paths inside the container (docker-compose.dev.yml mounts ./certs to /config)
CERT_PATH=/config/client_fullchain.pem
KEY_PATH=/config/client.key
LOG_LEVEL=INFO
HEALTH_INTERVAL_S=300
HOT_POLL_S=2
HOT_POLL_ACTIVE_S=1
PING_INTERVAL_S=25
# Fixed local UDP port for the DTLS socket; "random" to let the OS pick
DTLS_LOCAL_PORT=49700
