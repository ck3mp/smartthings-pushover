# ---- Appliances -----------------------------------------------------------
# Each appliance is on when its _IP is set; force with WASHER_ENABLED /
# DRYER_ENABLED=true|false. At least one must be enabled. Only one client may
# talk to an appliance at a time: never point two bridges at the same IP.
WASHER_ENABLED=
WASHER_IP=192.168.1.50
# Leave blank to auto-discover across 5684 + 49152-49160 (the WW80 uses 49154)
WASHER_PORT=
WASHER_NAME=Washing machine
# Course code -> name for nicer messages. `--dump washer` lists every code.
# WW80CGC04DAEEU (Table_02), derived from the firmware option table + manual:
WASHER_COURSE_NAMES=1C=Eco 40-60,1B=Cotton,25=Synthetics,20=Hygiene Steam,08=Rinse+Spin,74=Drum Clean,87=Downloaded,06=Bedding,7F=Wool/Delicates,65=Colours,8F=Intense Cold,96=Less Microfiber,34=Mixed Load,A0=Quick Wash 15'
# Fixed local UDP port for this appliance's DTLS socket; "random" to let the OS pick
WASHER_DTLS_LOCAL_PORT=49700

DRYER_ENABLED=
DRYER_IP=192.168.1.51
DRYER_PORT=
DRYER_NAME=Tumble dryer
# DV80CGC0B0AEEU (Table_03), from the firmware option table + manual:
DRYER_COURSE_NAMES=16=Cotton,18=Synthetics,1F=Mixed Load,19=Delicates,20=Iron Dry,1A=Wool,1D=Towels,1B=Bedding,1E=Outdoor,43=Downloaded,23=Quick Dry 35',27=Time Dry,25=Warm Air,24=Cool Air
DRYER_DTLS_LOCAL_PORT=49701

# ---- Pushover -----------------------------------------------------------
# Either set the values here, or point PUSHOVER_TOKEN_FILE / PUSHOVER_USER_FILE
# at files (Docker secrets). A direct value wins over its _FILE.
PUSHOVER_TOKEN=your-application-token
PUSHOVER_USER=your-user-key
# PUSHOVER_TOKEN_FILE=/run/secrets/pushover_token
# PUSHOVER_USER_FILE=/run/secrets/pushover_user
# Optional: restrict to one device name, pick a sound, set priority (-2..1)
PUSHOVER_DEVICE=
PUSHOVER_SOUND=
PUSHOVER_PRIORITY=0
# Sound used only for the "laundry is done" message (e.g. magic, bike)
PUSHOVER_FINISHED_SOUND=
# Priority for alarm/error notifications (exempt from quiet hours)
PUSHOVER_ALARM_PRIORITY=1

# ---- Events --------------------------------------------------------------
# Comma-separated. Default: cycle_scheduled,cycle_started,cycle_finished,
#                           cycle_paused,cycle_cancelled,alarm
# All: cycle_scheduled,cycle_started,cycle_finished,cycle_paused,cycle_resumed,
#      cycle_cancelled,phase_changed,alarm,power_on,power_off,remote_control,
#      child_lock,offline,online,startup
# Or EVENTS=all
EVENTS=
# Shorthand for adding "startup" to EVENTS: one message per appliance when
# the bridge first connects.
STARTUP_NOTIFY=false
# Per-event priority overrides, e.g. cycle_finished=1,phase_changed=-1
EVENT_PRIORITIES=
# Quiet hours: cap the priority of every non-alarm message inside this
# window (local time; set TZ). Blank disables.
QUIET_HOURS=
QUIET_PRIORITY=-1
# Identical alarm content is re-sent at most once per this many seconds, and
# at most 3 distinct alarms go out per window. 0 disables the limiter.
ALARM_REPEAT_S=600
# Seconds unreachable before an "offline" event fires (only if enabled)
OFFLINE_AFTER_S=900

# ---- Tuning (defaults are fine) -------------------------------------------
# Cert paths inside the container (docker-compose.dev.yml mounts ./certs to /config)
CERT_PATH=/config/client_fullchain.pem
KEY_PATH=/config/client.key
# Where the per-appliance cycle tracker is persisted; blank disables.
# The image defaults this to /data.
STATE_DIR=
# Heartbeat file for the Docker HEALTHCHECK (image default: /tmp/smartthings-pushover.heartbeat)
HEARTBEAT_PATH=
# Your time zone; used by QUIET_HOURS and log timestamps
TZ=Europe/London
LOG_LEVEL=INFO
HEALTH_INTERVAL_S=300
HOT_POLL_S=2
HOT_POLL_ACTIVE_S=1
PING_INTERVAL_S=25
